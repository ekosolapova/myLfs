<project>
    <name>GLIC STD</name>
    <modules>
        <module>
            <rules-root path="rules/*.xlsx"/>
            <method-filter>
                <includes>
                    <value>.+ DeterminePolicyRates\(.+\)</value>
                </includes>
            </method-filter>
        </module>
    </modules>
    <properties-file-name-pattern>STD .*-%state%-%effectiveDate:yyyyMMdd%-%startRequestDate:yyyyMMdd%</properties-file-name-pattern>
</project>
